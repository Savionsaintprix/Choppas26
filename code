<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Creed Quest</title>
<style>
:root{--bg:#0f1220;--card:#1b2038;--acc:#ffb347;--ok:#5be39a;--bad:#ff6b6b;--txt:#f4f4f8;--dim:#9aa0b8;--well:#2a3050}
*{box-sizing:border-box}
body{margin:0;font-family:-apple-system,system-ui,sans-serif;background:var(--bg);color:var(--txt);min-height:100vh;display:flex;justify-content:center;padding:16px}
.wrap{width:100%;max-width:480px;display:flex;flex-direction:column;gap:14px}
.hide{display:none!important}
h1{font-size:22px;margin:6px 0 0}
.tip{color:var(--dim);font-size:14px;line-height:1.4;margin:0}
.bar{height:10px;background:var(--well);border-radius:6px;overflow:hidden}
.bar>div{height:100%;background:var(--acc);width:0;transition:width .4s}
.card{background:var(--card);border-radius:18px;padding:22px;font-size:21px;line-height:1.45;min-height:170px;display:flex;flex-direction:column;justify-content:center;gap:12px}
.label{font-size:13px;text-transform:uppercase;letter-spacing:1px;color:var(--acc);font-weight:700}
.blank{color:var(--acc);font-weight:800}
button{font:inherit;font-size:18px;padding:16px;border-radius:14px;border:0;background:var(--acc);color:#1a1200;font-weight:700;cursor:pointer;width:100%}
button.small{width:auto;padding:8px 12px;font-size:14px;background:var(--well);color:var(--txt)}
.opts{display:flex;flex-direction:column;gap:10px}
.opt{background:var(--well);color:var(--txt);text-align:left;font-weight:500;font-size:17px;line-height:1.35}
.opt.right{background:var(--ok);color:#06210f}
.opt.wrong{background:var(--bad);color:#2a0606}
.row{display:flex;justify-content:space-between;align-items:center;font-size:14px;color:var(--dim);gap:8px;flex-wrap:wrap}
.row .btns{display:flex;gap:8px}
textarea{width:100%;height:240px;border-radius:14px;border:0;padding:14px;font:inherit;font-size:16px;background:var(--well);color:var(--txt);resize:vertical}
.box{background:var(--card);border-radius:18px;padding:16px;display:flex;flex-direction:column;gap:10px}
.big{font-size:52px;font-weight:800;text-align:center}
</style>
</head>
<body>
<div class="wrap">
  <h1>Creed Quest</h1>

  <!-- SETUP -->
  <div id="setup" class="wrap" style="gap:14px">
    <div class="box">
      <div class="label">Paste your creed</div>
      <textarea id="src" placeholder="Paste the full creed here. Long sentences get split into small pieces automatically."></textarea>
    </div>
    <button id="go">Start</button>
    <p class="tip">Tip: work in one sitting of about 10 minutes, then stand up and stretch. A round is 6 quick tasks, then a short reset break. Progress is saved on this phone only.</p>
  </div>

  <!-- GAME -->
  <div id="game" class="wrap hide" style="gap:14px">
    <div class="row"><span id="prog"></span><span id="pts"></span></div>
    <div class="bar"><div id="fill"></div></div>
    <div class="card" id="card"></div>
    <div class="opts" id="opts"></div>
    <button id="next" class="hide">Next</button>
    <div class="row">
      <span id="streak"></span>
      <span class="btns">
        <button class="small" id="edit">Edit creed</button>
        <button class="small" id="wipe">Start over</button>
      </span>
    </div>
  </div>
</div>

<script>
const KEY='creedquest.v1';
const $=id=>document.getElementById(id);
let chunks=[],stats=[],srcUsed='',cur=null,last=-1,score=0,streak=0,taskN=0,answered=false,breakDone=false;

const shuffle=a=>{a=[...a];for(let i=a.length-1;i>0;i--){const j=Math.random()*(i+1)|0;[a[i],a[j]]=[a[j],a[i]]}return a};
const clean=w=>w.replace(/[^A-Za-z']/g,'');
const el=(tag,cls,text)=>{const e=document.createElement(tag);if(cls)e.className=cls;if(text!=null)e.textContent=text;return e};
const save=()=>localStorage.setItem(KEY,JSON.stringify({src:srcUsed,stats}));
const allWords=()=>[...new Set(chunks.join(' ').split(/\s+/).map(clean).filter(w=>w.length>3))];

// Split into bite-sized lines: by sentence, then by comma if a piece is long.
function parse(s){
  return s.replace(/([.!?;])\s+/g,'$1\n').split('\n').flatMap(p=>{
    const t=p.trim();
    if(!t)return [];
    if(t.split(/\s+/).length<=14)return [t];
    return t.split(/,\s+/).map(x=>x.trim()).filter(Boolean);
  });
}

function show(screen){
  $('setup').classList.toggle('hide',screen!=='setup');
  $('game').classList.toggle('hide',screen!=='game');
}

function start(){
  const src=$('src').value.trim();
  chunks=parse(src);
  if(!chunks.length)return;
  const d=JSON.parse(localStorage.getItem(KEY)||'{}');
  srcUsed=src;
  stats=(d.src===src&&Array.isArray(d.stats)&&d.stats.length===chunks.length)?d.stats:chunks.map(()=>({s:0}));
  save();
  show('game');
  answered=false;breakDone=false;
  nextTask();
}

// Strength 0 = new/missed, 1 = read, 2 = recalled once, 3 = recalled twice in a row.
// Always pick from the weakest lines, so missed lines come back fast.
function nextTask(){
  if(stats.every(x=>x.s>=3)){renderDone();return;}
  if(taskN>0&&taskN%6===0&&!breakDone){breakDone=true;roundBreak();return;}
  breakDone=false;
  const low=Math.min(...stats.map(x=>x.s));
  let pool=chunks.map((_,i)=>i).filter(i=>stats[i].s===low&&i!==last);
  if(!pool.length)pool=chunks.map((_,i)=>i).filter(i=>stats[i].s===low);
  last=pool[Math.random()*pool.length|0];
  taskN++;answered=false;
  cur=makeTask(last);
  render();
}

function makeTask(i){
  const s=stats[i].s;
  const kinds=s===0?['read']:(i>0?['blank','next']:['blank']);
  const k=kinds[Math.random()*kinds.length|0];
  if(k==='read')return{k,i};
  if(k==='blank'){
    const words=chunks[i].split(/\s+/);
    const idxs=words.map((_,j)=>j).filter(j=>clean(words[j]).length>3);
    if(!idxs.length)return{k:'read',i};
    const j=idxs[Math.random()*idxs.length|0];
    const ans=clean(words[j]);
    const pool=allWords().filter(w=>w!==ans);
    const opts=shuffle([ans,...shuffle(pool).slice(0,2)]).map(t=>({t,ok:t===ans}));
    return{k,i,words,j,ans,opts};
  }
  const others=shuffle(chunks.map((_,n)=>n).filter(n=>n!==i)).slice(0,2);
  const opts=shuffle([i,...others]).map(n=>({t:chunks[n],ok:n===i}));
  return{k,i,opts};
}

function render(){
  const i=cur.i,c=$('card'),o=$('opts');
  c.innerHTML='';o.innerHTML='';
  $('next').classList.add('hide');
  $('prog').textContent=`Line ${i+1} of ${chunks.length}`;
  $('pts').textContent=`${score} pts`;
  $('streak').textContent=streak>1?`🔥 ${streak} in a row`:'';
  const total=stats.reduce((a,x)=>a+x.s,0);
  $('fill').style.width=(total/(3*chunks.length)*100)+'%';

  if(cur.k==='read'){
    c.append(el('div','label','New line: read it out loud'),el('div','',chunks[i]));
    const b=el('button','','Got it');
    b.onclick=()=>{
      if(answered)return;answered=true;
      stats[i].s=Math.max(1,stats[i].s);score+=5;save();
      b.classList.add('right');showNext();
    };
    o.append(b);
  }

  if(cur.k==='blank'){
    c.append(el('div','label','Fill in the blank'));
    const line=el('div','');
    let span=null;
    cur.words.forEach((w,j)=>{
      if(j===cur.j){span=el('span','blank','_____');line.append(span);}
      else line.append(w);
      line.append(' ');
    });
    c.append(line);
    cur.span=span;
    cur.opts.forEach(x=>o.append(optBtn(x)));
  }

  if(cur.k==='next'){
    c.append(el('div','label','What comes next?'),el('div','',chunks[i-1]));
    cur.opts.forEach(x=>o.append(optBtn(x)));
  }
}

function optBtn(x){
  const b=el('button','opt',x.t);
  b.dataset.ok=x.ok?'1':'0';
  b.onclick=()=>choose(b,x.ok);
  return b;
}

function choose(b,ok){
  if(answered)return;answered=true;
  const i=cur.i;
  [...$('opts').children].forEach(n=>{if(n.dataset.ok==='1')n.classList.add('right')});
  if(ok){
    stats[i].s=Math.min(3,stats[i].s+1);
    streak++;score+=10+2*streak;
  }else{
    b.classList.add('wrong');
    stats[i].s=0;streak=0;
  }
  if(cur.span)cur.span.textContent=cur.ans;
  save();showNext();
}

function showNext(){
  const n=$('next');n.textContent='Next';n.classList.remove('hide');
}

function roundBreak(){
  const c=$('card');
  c.innerHTML='';
  c.append(el('div','label','Quick reset'),el('div','',`Round done. Stand up, sip some water, and look at something far away for 30 seconds. Score: ${score}.`));
  $('opts').innerHTML='';
  $('next').textContent='Keep going';
  $('next').classList.remove('hide');
}

function renderDone(){
  const c=$('card');
  c.innerHTML='';
  c.append(el('div','big','✓'),el('div','',"You've got every line. Come back tomorrow for a 5-minute check."));
  $('opts').innerHTML='';
  $('next').classList.add('hide');
}

$('go').onclick=start;
$('next').onclick=()=>{$('next').textContent='Next';nextTask();};
$('edit').onclick=()=>show('setup');
$('wipe').onclick=()=>{
  if(!confirm('Clear your progress and start this creed from scratch?'))return;
  stats=chunks.map(()=>({s:0}));save();
  score=0;streak=0;taskN=0;last=-1;breakDone=false;
  nextTask();
};

// Resume automatically if there is saved creed text.
const saved=JSON.parse(localStorage.getItem(KEY)||'{}');
if(saved.src){$('src').value=saved.src;start();}
</script>
</body>
</html>
